# ---- Configuración de la instancia de xlive ----
# Grabaciones. Apunta esto al disco grande de la máquina, p. ej. /datos/grabaciones
STRMNTR_DOWNLOAD_DIR=downloads

# Avisa y detiene la grabación por debajo de este % libre. NO borra nada.
STRMNTR_MIN_FREE_SPACE=5.0

# Las grabaciones nacen ya troceadas en bloques de 20 min (1200 s), para que
# nunca aparezca un fichero de 4 horas que haya que partir antes de editar.
STRMNTR_SEGMENT_TIME=1200

# Interfaz web. 0.0.0.0 la deja visible en la red local.
STRMNTR_HOST=0.0.0.0
STRMNTR_PORT=5000
# CÁMBIALA. Usuario: admin
STRMNTR_PASSWORD=GENERAR-EN-INSTALACION

# Avisos de Telegram y resumen de horas: apagados en esta instancia.
STRMNTR_WATCHDOG=false
